# Copy this file to `.env` in the backend/ directory and fill in real values.
# Never commit the real `.env` file.

# --- App ---
APP_NAME=MediBot
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3010

# --- Auth / JWT ---
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Data locations (do NOT hardcode paths in code) ---
# Folder that contains the mediassist.db SQLite file used by SQL RAG (Component 4).
MEDIASSIST_DB_PATH=/absolute/path/to/mediassist_data/db/mediassist.db
# Folder that contains the billing/clinical/nursing/equipment/general document subfolders,
# used by the ingestion pipeline (Component 1).
MEDIASSIST_DATA_PATH=/absolute/path/to/mediassist_data

# --- Vector store (used once Components 1-3 are implemented) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Cloud LLM inference API (used once Components 2-4 are implemented) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
